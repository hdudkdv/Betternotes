opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Create or reuse a Distribution cert and App Store profile via the Connect API key"
  lane :ci_signing do
    key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ID")
      .gsub(/AuthKey_/i, "")
      .gsub(/\.p8\z/i, "")
      .strip
    issuer_id = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID").strip
    key_content = ENV.fetch("APP_STORE_CONNECT_API_KEY").gsub("\r", "").strip
    UI.user_error!("APP_STORE_CONNECT_API_KEY_ID looks empty after cleanup") if key_id.empty?
    UI.user_error!("APP_STORE_CONNECT_ISSUER_ID must be the UUID from Users and Access, not the Team ID") unless issuer_id.match?(/\A[0-9a-f-]{36}\z/i)
    UI.message("Using App Store Connect key #{key_id} (#{key_content.include?("BEGIN PRIVATE KEY") ? "PEM" : "raw"})")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )

    cert(
      api_key: api_key,
      development: false,
      force: false,
      keychain_path: ENV.fetch("KEYCHAIN_PATH"),
      keychain_password: ENV.fetch("KEYCHAIN_PASSWORD")
    )

    sigh(
      api_key: api_key,
      app_identifier: "de.notis.app",
      adhoc: false,
      development: false,
      force: true,
      filename: "Notis_AppStore.mobileprovision"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: "de.notis.app",
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      targets: ["Runner"]
    )

    github_env = ENV["GITHUB_ENV"]
    next if github_env.to_s.empty?

    File.open(github_env, "a") do |file|
      file.puts "SIGH_NAME=#{lane_context[SharedValues::SIGH_NAME]}"
      file.puts "SIGH_UDID=#{lane_context[SharedValues::SIGH_UDID]}"
    end
  end
end
