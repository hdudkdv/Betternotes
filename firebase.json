{
  "hosting": [
    {
      "site": "notis-notizbuecher",
      "public": "hosting",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        { "source": "/privacy", "destination": "/datenschutz", "type": 301 },
        { "source": "/terms", "destination": "/agb", "type": 301 },
        { "source": "/legal-notice", "destination": "/impressum", "type": 301 }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|png|svg|ico|webp)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=604800"
            }
          ]
        }
      ]
    },
    {
      "site": "notis-2dee0",
      "public": "hosting",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://notis-notizbuecher.web.app",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://notis-notizbuecher.web.app/:path",
          "type": 301
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "notis-2dee0",
          "appId": "1:471441564519:android:8f6f81842723b83c6305c2",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "notis-2dee0",
          "configurations": {
