rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /oer_materials/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // On-device Gemma weights. Read is public so every install can fetch
    // after Marketplace unlock; writes stay in the Firebase console / CLI.
    match /gemma/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
